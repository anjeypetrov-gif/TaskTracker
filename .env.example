# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already excluded in .gitignore).

# Required in any real deployment. The old key was hardcoded in auth.py and
# is now public on GitHub — generate a fresh one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Optional: only needed if you're using Postgres instead of the default
# local SQLite file. Leave unset for local dev.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
